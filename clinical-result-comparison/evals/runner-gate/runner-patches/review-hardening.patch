+def receipt_relpath(pointer):
+    prefix = "/workspace/tool_results/"
+    if not isinstance(pointer, str) or not pointer.startswith(prefix):
+        raise ValueError("invalid receipt prefix")
+    parts = pointer[len(prefix):].split("/")
+    if (len(parts) != 2 or any(p in ("", ".", "..") for p in parts)
+            or not all(re.fullmatch(r"[A-Za-z0-9._-]+", p) for p in parts)
+            or not re.search(r"\.[A-Za-z0-9]{1,8}$", parts[-1])):
+        raise ValueError("unsafe or unsupported receipt path")
+    return "/".join(parts)
+
+
+def receipt_destination(out_dir, pointer):
+    rel = receipt_relpath(pointer)
+    base = os.path.abspath(os.path.join(out_dir, "tool_results"))
