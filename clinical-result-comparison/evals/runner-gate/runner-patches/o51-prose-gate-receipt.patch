     # A missing invocation is a FAIL — the gate is part of the contract, not an option. A run that
     # did invoke it but never echoed the code is a WARN: the tool-call evidence is there, only the
     # number is unreadable, and turning that into a FAIL would punish the harness, not the run.
+    #
+    # O51 / R61-3:B9 — a command that merely *mentions* tell-scan.py can still end with somebody
+    # else's status. Measured in `20261013-134217-r61-sem-2`: a chain `patch.py … && … ; echo
+    # "SCAN_EXIT=$?"` short-circuited on a patch.py assertion failure (its exit is 3 as well) with
+    # no scanner output anywhere, and the old flat join-then-regex harvested that 3 as the gate's
+    # verdict → false FAIL in a green run. So the verdict is harvested PER tool-return and only
+    # from a return that carries the scanner's own banner (`强 N / 弱 M` header or the
+    # `合计强命中 N 条` total); the marker is then read from the text *after* that banner, which is
+    # where the `; echo` of the same pipeline lands (the R63 general form echoes
+    # `EXIT=${PIPESTATUS[0]}` instead of `SCAN_EXIT=$?`, so both names are accepted, and a
+    # canonical marker wins over a bare `EXIT=` from another command in the same chain).
     def _cmd_text(inp):
         if not isinstance(inp, dict):
             return ""
@@ -1517,25 +1528,39 @@
 
     scan_cids = [cid for cid, nm, inp in st["calls"]
                  if nm == "execute" and "tell-scan.py" in _cmd_text(inp)]
-    scan_out = "\n".join(str(st["outputs"].get(cid) or "") for cid in scan_cids)
